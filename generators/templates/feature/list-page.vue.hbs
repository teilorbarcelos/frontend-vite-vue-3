<script setup lang="ts">
import { ref, computed } from 'vue';
import { useRouter } from 'vue-router';
import { useQuery, useMutation, useQueryClient } from '@tanstack/vue-query';
import type { AxiosError } from 'axios';
import { DataTable } from '@/components/ui/DataTable';
import ListPageHeader from '@/components/ui/ListPageHeader.vue';
import { useAuthStore } from '@/stores/auth';
import { useToastStore } from '@/stores/toast';
import { useDataTable } from '@/hooks/useDataTable';
import { {{camelCase name}}Service } from '../services/{{kebabCase name}}.service';
import {{pascalCase name}}Filters from '../components/{{pascalCase name}}Filters.vue';
import { {{constantCase name}}_SEARCHABLE_FIELDS } from '../constants/{{kebabCase name}}.constants';
import { get{{pascalCase name}}Columns } from '../constants/{{camelCase name}}HeaderMap';

const {
  page,
  size,
  searchWord,
  filters,
  sort,
  handleSearch,
  handleFilter,
  tableProps
} = useDataTable();

const isFilterOpen = ref(false);
const router = useRouter();
const queryClient = useQueryClient();
const authStore = useAuthStore();
const toastStore = useToastStore();

const permissions = computed(() => ({
  canCreate: authStore.hasPermission('{{kebabCase name}}', 'create'),
  canUpdate: authStore.hasPermission('{{kebabCase name}}', 'view'),
  canDelete: authStore.hasPermission('{{kebabCase name}}', 'delete'),
}));

const { data, isError, isFetching } = useQuery({
  queryKey: computed(() => ['{{kebabCase name}}s', page.value, size.value, searchWord.value, filters.value, sort.value]),
  queryFn: () => {{camelCase name}}Service.get{{pascalCase name}}s({
    page: page.value, 
    size: size.value, 
    searchWord: searchWord.value, 
    searchFields: {{constantCase name}}_SEARCHABLE_FIELDS,
    filters: filters.value,
    sort: sort.value,
    all: true
  }),
});

const toggleStatusMutation = useMutation({
  mutationFn: ({ id, active }: { id: string; active: boolean }) => {{camelCase name}}Service.toggleStatus(id, active),
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['{{kebabCase name}}s'] });
    toastStore.success('Status atualizado!');
  },
  onError: (err: AxiosError<{ message?: string }>) => {
    toastStore.error(err.response?.data?.message || 'Erro ao atualizar status.');
  }
});

const deleteMutation = useMutation({
  mutationFn: (id: string) => {{camelCase name}}Service.delete{{pascalCase name}}(id),
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['{{kebabCase name}}s'] });
    toastStore.success('Excluído com sucesso!');
  },
  onError: (err: AxiosError<{ message?: string }>) => {
    toastStore.error(err.response?.data?.message || 'Erro ao excluir.');
  }
});

const columns = computed(() => 
  get{{pascalCase name}}Columns(
    (id, active) => toggleStatusMutation.mutate({ id, active }),
    (id) => router.push(`/{{kebabCase name}}s/update/${id}`),
    (id) => deleteMutation.mutate(id),
    permissions.value
  )
);
</script>

<template>
  <div class="flex-1 flex flex-col min-h-0">
    <ListPageHeader
      title="{{pascalCase name}}s"
      @search="handleSearch"
      @filter-click="isFilterOpen = true"
      :filter-count="Object.keys(filters).length"
      :on-create-click="permissions.canCreate ? () => router.push('/{{kebabCase name}}s/new') : undefined"
      create-label="Novo {{pascalCase name}}"
    />

    <{{pascalCase name}}Filters
      :is-open="isFilterOpen"
      :initial-values="filters"
      @close="isFilterOpen = false"
      @filter="handleFilter"
    />

    <div v-if="isError" class="p-8 text-center text-red-500">Erro ao carregar dados</div>

    <DataTable
      v-else
      v-bind="tableProps"
      :data="data?.items || []"
      :header-map="columns"
      :is-loading="isFetching"
      :total-items="data?.total || 0"
    />
  </div>
</template>
